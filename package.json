{
  "name": "dsh-browser-view",
  "version": "0.6.0",
  "description": "DSH 插件:共享 Playwright 浏览器自动化(37 个 browser_* 工具,含跨 Frame/IFrame 穿透定位、视口感知动态快照、多模态 SoM 视口标徽、高阶批量表单智能填充与 UI 适配器稳态等待、Playwright 规范代码一键导出、语义元素查找、批处理、视觉回归、选择器自愈、增量快照历史版本)+ 人机协作(人工接管等待、敏感操作审批(多维自适应策略引擎硬拦截)、人机混合录制、面板一键重跑)+ CDP Screencast 低延迟流式推流、拟人化贝塞尔轨迹与高斯击键引擎、会话全景时光机与排障、企业富控件矩阵。仅依赖 playwright-core,不依赖任何 @deepseek-ai 运行时包。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false && tsc -p tsconfig.test.json --noEmit --pretty false",
    "lint": "biome check src test",
    "format": "biome format --write src test",
    "test": "vitest run",
    "test:algo": "tsx scripts/test-dev-server-algo-config.ts",
    "test:enterprise": "tsx scripts/test-dev-server-enterprise.ts",
    "test:energy": "tsx scripts/test-dev-server-energy.ts",
    "dev:server": "tsx scripts/dev-server.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelloTomBruce/dsh-browser.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "browser",
    "playwright",
    "automation",
    "testing"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "playwright-core": "^1.49.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^3.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
