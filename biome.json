{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["src/**/*", "test/**/*", "*.ts", "*.json"]
	},
	"formatter": {
		"enabled": false
	},
	"assist": { "actions": { "source": { "organizeImports": "off" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none",
			"correctness": {
				"noUnusedVariables": "warn",
				"noConstAssign": "error",
				"noUnreachable": "error"
			},
			"suspicious": {
				"noDoubleEquals": "warn",
				"noDebugger": "error"
			}
		}
	}
}
